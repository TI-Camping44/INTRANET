# =====================================================================
# Intranet SGC · Camping 44 S.A.
# Copie este archivo como .env.local y complete los valores.
# NUNCA suba .env.local al repositorio.
# =====================================================================

# --- Supabase --------------------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="clave-anonima-publica"

# Clave de servicio. Ignora las politicas RLS: se usa unicamente en el
# trabajo programado de alertas y en el script de importacion.
# No debe exponerse jamas al navegador ni compartirse por correo.
SUPABASE_SERVICE_ROLE_KEY="clave-de-servicio-secreta"

# --- Sitio -----------------------------------------------------------
# URL publica del sistema. Se usa para los enlaces de los correos.
NEXT_PUBLIC_SITIO_URL="http://localhost:3000"

# --- Correo (SMTP de Google Workspace) -------------------------------
# Cuenta del propio espacio de trabajo, por ejemplo sgc@camping44.com.py,
# con verificacion en dos pasos y una contrasena de aplicacion.
# Ver docs/despliegue.md, seccion "Correo".
SMTP_HOST="smtp.gmail.com"
SMTP_PUERTO="465"
SMTP_USUARIO="sgc@camping44.com.py"
SMTP_CLAVE="contrasena-de-aplicacion-de-16-caracteres"
SMTP_REMITENTE="Intranet SGC <sgc@camping44.com.py>"

# --- Trabajo programado de alertas -----------------------------------
# Cadena larga y aleatoria. Vercel Cron la envia en la cabecera
# Authorization para que nadie mas pueda disparar el proceso.
# El nombre lo fija Vercel, no el proyecto: solo con la variable llamada
# exactamente CRON_SECRET firma los trabajos programados de vercel.json.
CRON_SECRET="cadena-larga-y-aleatoria"

# --- Migracion desde Sofidya (uso unico) -----------------------------
# Solo se necesita mientras dure la importacion inicial. Despues, borrar.
# Endpoint real del API. Ver docs/api-sofidya.md.
SOFIDYA_API_URL="https://www.sofidya.com/api/api.php"
SOFIDYA_SECRET_KEY=""
# Archivo de ejemplo usado cuando no hay SecretKey disponible.

# --- Supabase CLI local (opcional) -----------------------------------
# Solo se necesitan si va a levantar Supabase en su maquina con
# `supabase start`. Ver supabase/config.toml.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_GOOGLE_SECRET=""
